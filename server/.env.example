# 复制为 .env.local 并填写,不要提交 .env.local
# 直接粘贴 Neon 控制台 dev 分支的连接串(postgresql://...),代码里转换成 JDBC 格式
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 对话模型:OpenAI 兼容接口,BASE_URL 填到 /v1 为止
# 百炼:{WorkspaceId} 换成业务空间 ID;其他地域把 cn-beijing 换成对应地域
AI_CHAT_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_CHAT_API_KEY=
AI_CHAT_MODEL=qwen3.8-flash

# Embedding 模型:OpenAI 兼容接口,与对话模型独立配置,可换不同厂商
AI_EMBEDDING_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=qwen3.7-text-embedding
# 向量维度,建表时固定;qwen3.7-text-embedding 默认 1024,可选 2560/2048/1536/1024/768/512/256
AI_EMBEDDING_DIMENSIONS=1024
